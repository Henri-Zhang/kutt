<thead>
  {{> admin/table_tab title='domains'}}
  <tr class="controls domains-controls with-filters">
    <th class="filters">
      <div>
        <div class="search-input-wrapper">
          <input
            id="search"
            name="search"
            type="text"
            placeholder="搜索域名..."
            class="table-input search admin"
            hx-on:input="onSearchChange(event)"
            hx-on:keyup="resetTableNav()"
            value="{{query.search}}"
          />
          <button
            type="button"
            aria-label="清除搜索"
            class="clear"
            onclick="clearSeachInput(event)"
          >
            {{> icons/x}}
          </button>
        </div>
        <div class="search-input-wrapper">
          <input
            id="search_user"
            name="user"
            type="text"
            placeholder="搜索用户..."
            class="table-input search admin"
            hx-on:input="onSearchChange(event)"
            hx-on:keyup="resetTableNav()"
            value="{{query.user}}"
          />
          <button
            type="button"
            aria-label="清除用户"
            class="clear"
            onclick="clearSeachInput(event)"
          >
            {{> icons/x}}
          </button>
        </div>
        <select id="domains-select-banned" name="banned" class="table-input ban" hx-on:change="resetTableNav()">
          <option value="" selected>封禁状态...</option>
          <option value="true">已封禁</option>
          <option value="false">未封禁</option>
        </select>
      </div>
      <div>
        <select id="domains-select-links" name="links" class="table-input links" hx-on:change="resetTableNav()">
          <option value="" selected>链接...</option>
          <option value="true" {{#ifEquals query.links 'true'}}selected{{/ifEquals}}>有链接</option>
          <option value="false" {{#ifEquals query.links 'true'}}selected{{/ifEquals}}>无链接</option>
        </select>
        <select id="domains-select-owner" name="owner" class="table-input owner" hx-on:change="resetTableNav()">
          <option value="" selected>所有者...</option>
          <option value="true" {{#ifEquals query.owner 'true'}}selected{{/ifEquals}}>有所有者</option>
          <option value="false" {{#ifEquals query.owner 'true'}}selected{{/ifEquals}}>无所有者</option>
        </select>
        <input id="total" name="total" type="hidden" value="{{total}}" />
        <input id="limit" name="limit" type="hidden" value="10" />
        <input id="skip" name="skip" type="hidden" value="0" />
        <button
          class="table primary"
          hx-on:click='openDialog("admin-table-dialog")'
          hx-get="/add-domain"
          hx-target="#admin-table-dialog .content-wrapper"
          hx-indicator="#admin-table-dialog"
        >
          <span>{{> icons/plus}}</span>
          添加域名
        </button>
      </div>
    </th>
    {{> admin/table_nav}}
  </tr>
  <tr>
    <th class="domains-id">ID</th>
    <th class="domains-address">地址</th>
    <th class="domains-homepage">主页</th>
    <th class="domains-created-at">创建时间</th>
    <th class="domains-links-count">链接总数</th>
    <th class="domains-actions"></th>
  </tr>
</thead>
