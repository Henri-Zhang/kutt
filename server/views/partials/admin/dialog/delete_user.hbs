<div class="content">
  <h2>删除用户？</h2>
  <p>
    你确定要删除用户 &quot;<b>{{email}}</b>&quot; 吗？<br/>
    <b>包括其链接在内的所有数据</b>都将被删除。
  </p>
  <div class="buttons">
    <button type="button" hx-on:click="closeDialog()">取消</button>
    <button
      type="button"
      class="danger confirm"
      hx-delete="/api/users/admin/{id}"
      hx-ext="path-params"
      hx-vals='{"id":"{{id}}"}'
      hx-target="closest .content"
      hx-swap="none"
      hx-indicator="closest .content"
      hx-select-oob="#dialog-error"
    >
      <span>{{> icons/trash}}</span>
      删除
    </button>
    {{> icons/spinner}}
  </div>
  <div id="dialog-error">
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  </div>
</div>
