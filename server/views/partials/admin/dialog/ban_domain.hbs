<div class="content">
  <h2>封禁域名？</h2>
  <p>
    你确定要封禁域名 &quot;<b>{{address}}</b>&quot; 吗？
  </p>
  <div class="ban-checklist">
    {{#if hasUser}}
      <label class="checkbox">
        <input id="ban-domain-user" name="user" type="checkbox" />
        所有者
      </label>
    {{/if}}
    {{#if hasLink}}
      <label class="checkbox">
        <input id="ban-domain-links" name="links" type="checkbox" />
        链接
      </label>
    {{/if}}
  </div>
  <div class="buttons">
    <button type="button" hx-on:click="closeDialog()">取消</button>
    <button
      type="button"
      class="danger confirm"
      hx-post="/api/domains/admin/ban/{id}"
      hx-ext="path-params"
      hx-vals='{"id":"{{id}}"}'
      hx-target="closest .content"
      hx-swap="none"
      hx-include=".ban-checklist"
      hx-indicator="closest .content"
      hx-select-oob="#dialog-error"
    >
      <span class="stop">
        {{> icons/stop}}
      </span>
      封禁
    </button>
    {{> icons/spinner}}
  </div>
  <div id="dialog-error">
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  </div>
</div>
