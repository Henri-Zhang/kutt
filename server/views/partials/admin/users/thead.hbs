<thead>
  {{> admin/table_tab title='users'}}
  <tr class="controls users-controls with-filters">
    <th class="filters">
      <div>
        <div class="search-input-wrapper">
          <input
            id="search"
            name="search"
            type="text"
            placeholder="搜索用户..."
            class="table-input search admin"
            hx-on:input="onSearchChange(event)"
            hx-on:keyup="resetTableNav()"
            value="{{query.search}}"
          />
          <button
            type="button"
            aria-label="清除搜索"
            class="clear"
            onclick="clearSeachInput(event)"
          >
            {{> icons/x}}
          </button>
        </div>
        <select  id="users-select-verified" name="verified" class="table-input verification" hx-on:change="resetTableNav()">
          <option value="">验证状态...</option>
          <option value="true" {{#ifEquals query.verified 'true'}}selected{{/ifEquals}}>已验证</option>
          <option value="false" {{#ifEquals query.verified 'false'}}selected{{/ifEquals}}>未验证</option>
        </select>
        <select id="users-select-banned" name="banned" class="table-input ban" hx-on:change="resetTableNav()">
          <option value="" selected>封禁状态...</option>
          <option value="true">已封禁</option>
          <option value="false">未封禁</option>
        </select>
        <select id="users-select-role" name="role" class="table-input role" hx-on:change="resetTableNav()">
          <option value="">角色...</option>
          <option value="USER" {{#ifEquals query.role 'USER'}}selected{{/ifEquals}}>用户</option>
          <option value="ADMIN" {{#ifEquals query.role 'ADMIN'}}selected{{/ifEquals}}>管理员</option>
        </select>
      </div>
      <div>
        <select id="users-select-domain" name="domains" class="table-input domains" hx-on:change="resetTableNav()">
          <option value="">域名...</option>
          <option value="true" {{#ifEquals query.domains 'true'}}selected{{/ifEquals}}>有域名</option>
          <option value="false" {{#ifEquals query.domains 'false'}}selected{{/ifEquals}}>无域名</option>
        </select>
        <select id="users-select-links" name="links" class="table-input links" hx-on:change="resetTableNav()">
          <option value="" selected>链接...</option>
          <option value="true" {{#ifEquals query.links 'true'}}selected{{/ifEquals}}>有链接</option>
          <option value="false" {{#ifEquals query.links 'true'}}selected{{/ifEquals}}>无链接</option>
        </select>
        <input id="total" name="total" type="hidden" value="{{total}}" />
        <input id="limit" name="limit" type="hidden" value="10" />
        <input id="skip" name="skip" type="hidden" value="0" />
        <button
          class="table primary"
          hx-on:click='openDialog("admin-table-dialog")'
          hx-get="/create-user"
          hx-target="#admin-table-dialog .content-wrapper"
          hx-indicator="#admin-table-dialog"
        >
          <span>{{> icons/new_user}}</span>
          创建用户
        </button>
      </div>
    </th>
    {{> admin/table_nav}}
  </tr>
  <tr>
    <th class="users-id">ID</th>
    <th class="users-email">邮箱</th>
    <th class="users-created-at">创建时间</th>
    <th class="users-verified">已验证</th>
    <th class="users-role">角色</th>
    <th class="users-links-count">链接总数</th>
    <th class="users-actions"></th>
  </tr>
</thead>
