<header>
  <div class="logo-wrapper">
    <a class="logo nav" href="/" title="首页">
      <img src="/images/logo.png" alt="葱花短链" width="18" height="24" />
      {{site_name}}
    </a>
    {{!-- <ul class="logo-links">
      <li>
        <a class="nav" href="https://github.com/thedevs-network/kutt" target="_blank" rel="noopener noreferrer" title="GitHub">
          GitHub
        </a>
      </li>
      {{#if report_email}}
        <li>
          <a class="nav" href="/report" title="举报滥用">
            举报
          </a>
        </li>
      {{/if}}
    </ul> --}}
  </div>
  <nav>
    <ul>
      {{#unless user}}
        {{#unless login_disabled}}
          <li>
            <a class="button primary" href="/login" title="登录或注册">
              登录 / 注册
            </a>
          </li>
        {{/unless}}
      {{/unless}}
      {{#if user}}
        <li>
          <a class="button primary" href="/settings" title="设置">
            <span>{{> icons/cog}}</span>
            设置
          </a>
        </li>
        {{#if isAdmin}}
          <li>
            <a class="button secondary" href="/admin" title="管理">
              <span>{{> icons/shield}}</span>
              管理
            </a>
          </li>
        {{/if}}
        <li>
          <a class="nav" href="/logout" title="退出登录">
            退出登录
          </a>
        </li>
      {{/if}}
    </ul>
  </nav>
</header>