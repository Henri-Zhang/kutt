<div class="content">
  <h2>封禁链接？</h2>
  <p>
    你确定要封禁链接 &quot;<b>{{link}}</b>&quot; 吗？
  </p>
  <div class="ban-checklist">
    <label class="checkbox">
      <input id="user" name="user" type="checkbox" />
      用户
    </label>
    <label class="checkbox">
      <input id="userLinks" name="userLinks" type="checkbox" />
      用户链接
    </label>
    <label class="checkbox">
      <input id="host" name="host" type="checkbox" />
      主机
    </label>
    <label class="checkbox">
      <input id="domain" name="domain" type="checkbox" />
      域名
    </label>
  </div>
  <div class="buttons">
    <button type="button" hx-on:click="closeDialog()">取消</button>
    <button
      type="button"
      class="danger confirm"
      hx-post="/api/links/admin/ban/{id}"
      hx-ext="path-params"
      hx-vals='{"id":"{{id}}"}'
      hx-target="closest .content"
      hx-swap="none"
      hx-include=".ban-checklist"
      hx-indicator="closest .content"
      hx-select-oob="#dialog-error"
    >
      <span class="stop">
        {{> icons/stop}}
      </span>
      封禁
    </button>
    {{> icons/spinner}}
  </div>
  <div id="dialog-error">
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  </div>
</div>
