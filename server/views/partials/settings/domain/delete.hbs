<div class="content">
  <h2>删除域名？</h2>
  <p>
    你确定要删除域名 &quot;<b>{{address}}</b>&quot; 吗？
  </p>
  <div class="buttons">
    <button type="button" hx-on:click="closeDialog()">取消</button>
    <button
      type="button"
      class="danger confirm"
      hx-delete="/api/domains/{id}"
      hx-ext="path-params"
      hx-vals='{"id":"{{id}}"}'
      hx-target="closest .content"
      hx-swap="none"
      hx-indicator="closest .content"
      hx-select-oob="#dialog-error"
    >
      <span>{{> icons/trash}}</span>
      删除
    </button>
    {{> icons/spinner}}
  </div>
  <div id="dialog-error">
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  </div>
</div>
