{{> header}}
<section id="verify-change-email" class="section-container verify-page">
  {{#if token_verified}}
    <h2 hx-get="/" hx-trigger="load delay:1s" hx-target="body" hx-push-url="/">
      邮箱地址已验证。正在跳转到首页...
    </h2>
  {{else}}
    <h2>
      {{> icons/x}}
      无法验证邮箱地址。请重试。
    </h2>
    {{#if user}}
      <a href="/settings" title="设置">设置 →</a>
    {{else}}
      <a href="/login" title="登录或注册">登录 / 注册 →</a>
    {{/if}}
  {{/if}}
</section>
{{> footer}}
