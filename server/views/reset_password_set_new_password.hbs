{{> header}}
<section
  id="new-password"
  class="section-container {{#unless token_verified}}verify-page{{/unless}}"
>
  {{#if token_verified}}
    <h2>
      重置密码。
    </h2>
    <p>设置你的新密码。</p>
    {{> reset_password/new_password_form}}
  {{else}}
    <h2>
      {{> icons/x}}
      密码重置令牌无效。请重试。
    </h2>
    <a href="/reset-password" title="重置密码">重置密码 →</a>
  {{/if}}
</section>
{{> footer}}
